generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String         @id @db.Uuid
  organizations Organization[]

  @@map("user")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @unique @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer    Customer[]
  order       Order[]
  transaction Transaction[]

  @@map("organization")
  @@schema("public")
}

model Customer {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  phone          String?
  address        String?
  note           String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order[]
  transactions Transaction[]

  @@map("customer")
  @@schema("public")
}

model Order {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  isCanceled     Boolean  @default(false) @map("is_canceled")
  isPaid         Boolean  @default(false) @map("is_paid")
  orderedAt      DateTime @map("ordered_at") @db.Timestamptz
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item         OrderItem[]

  @@map("order")
  @@schema("public")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  description String
  unit_price  Decimal  @db.Decimal(10, 2)
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  deliveredAt DateTime @map("delivered_at") @db.Timestamptz
  note        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
  @@schema("public")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  customerId     String?           @map("customer_id") @db.Uuid
  description    String?
  amount         Decimal           @db.Decimal(10, 2)
  method         TransactionMethod
  madeAt         DateTime          @map("made_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("transaction")
  @@schema("public")
}

enum TransactionMethod {
  PIX         @map("pix")
  CASH        @map("cash")
  CREDIT_CARD @map("credit_card")
  DEBIT_CARD  @map("debit_card")

  @@map("transaction_method")
  @@schema("public")
}
