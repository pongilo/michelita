generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String         @id @db.Uuid
  organizations Organization[]

  @@map("user")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @unique @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer        Customer[]
  order           Order[]
  product         Product[]
  productCategory ProductCategory[]
  supply          Supply[]
  recipe          Recipe[]

  @@map("organization")
  @@schema("public")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phone          String?  @unique
  address        String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order[]

  @@map("customer")
  @@schema("public")
}

model Order {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  isPaid         Boolean  @default(false) @map("is_paid")
  orderedAt      DateTime @map("ordered_at") @db.Timestamptz
  note           String?
  shippingFee    Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  discount       Decimal? @db.Decimal(10, 2)

  total Decimal @default(0) @db.Decimal(10, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item         OrderItem[]

  @@map("order")
  @@schema("public")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  description String
  unit_price  Decimal  @db.Decimal(10, 2)
  quantity    Int
  deliveredAt DateTime @map("delivered_at") @db.Timestamptz
  isDelivered Boolean  @default(false) @map("is_delivered")
  note        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
  @@schema("public")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  description    String?
  imageUrl       String?  @map("image_url")
  price          Decimal  @db.Decimal(10, 2)
  multiplier     Decimal? @db.Decimal(6, 2)
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  supply       ProductSupply[]
  recipe       ProductRecipe[]

  @@map("product")
  @@schema("public")
}

model ProductCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  displayOrder   Int     @default(0) @map("display_order")
  displayLimit   Int?    @map("display_limit")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product[]

  @@unique([organizationId, slug])
  @@map("product_category")
  @@schema("public")
}

model Supply {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  unit             String
  purchasePrice    Decimal  @map("purchase_price") @db.Decimal(10, 2)
  purchaseQuantity Decimal  @map("purchase_quantity") @db.Decimal(10, 3)
  costPerUnit      Decimal  @map("cost_per_unit") @db.Decimal(12, 6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      ProductSupply[]
  recipe       RecipeSupply[]

  @@map("supply")
  @@schema("public")
}

model ProductSupply {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  supplyId  String  @map("supply_id") @db.Uuid
  quantity  Decimal @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([productId, supplyId])
  @@map("product_supply")
  @@schema("public")
}

model Recipe {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  yieldQuantity  Decimal  @map("yield_quantity") @db.Decimal(10, 3)
  yieldUnit      String   @map("yield_unit")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supply       RecipeSupply[]
  product      ProductRecipe[]

  @@map("recipe")
  @@schema("public")
}

model RecipeSupply {
  id       String  @id @default(uuid()) @db.Uuid
  recipeId String  @map("recipe_id") @db.Uuid
  supplyId String  @map("supply_id") @db.Uuid
  quantity Decimal @db.Decimal(10, 3)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([recipeId, supplyId])
  @@map("recipe_supply")
  @@schema("public")
}

model ProductRecipe {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  recipeId  String  @map("recipe_id") @db.Uuid
  quantity  Decimal @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([productId, recipeId])
  @@map("product_recipe")
  @@schema("public")
}
