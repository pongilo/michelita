generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String         @id @db.Uuid
  organizations Organization[]

  @@map("user")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @unique @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer        Customer[]
  order           Order[]
  product         Product[]
  productCategory ProductCategory[]

  @@map("organization")
  @@schema("public")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phone          String?  @unique
  address        String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order[]

  @@map("customer")
  @@schema("public")
}

model Order {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  isPaid         Boolean  @default(false) @map("is_paid")
  orderedAt      DateTime @map("ordered_at") @db.Timestamptz
  note           String?
  shippingFee    Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  discount       Decimal? @db.Decimal(10, 2)

  total Decimal @default(0) @db.Decimal(10, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item         OrderItem[]

  @@map("order")
  @@schema("public")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  description String
  unit_price  Decimal  @db.Decimal(10, 2)
  quantity    Int
  deliveredAt DateTime @map("delivered_at") @db.Timestamptz
  isDelivered Boolean  @default(false) @map("is_delivered")
  note        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
  @@schema("public")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id])

  @@map("product")
  @@schema("public")
}

model ProductCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  displayOrder   Int     @default(0) @map("display_order")
  displayLimit   Int?    @map("display_limit")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product[]

  @@unique([organizationId, slug])
  @@map("product_category")
  @@schema("public")
}
