generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String         @id @db.Uuid
  organizations Organization[]

  @@map("user")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @unique @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers    Customer[]
  orders       Order[]
  transactions Transaction[]

  @@map("organization")
  @@schema("public")
}

model Customer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  phone          String
  address        String
  note           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@map("customer")
  @@schema("public")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  status         OrderStatus
  orderedAt      DateTime    @map("ordered_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  transactions Transaction[]

  @@map("order")
  @@schema("public")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  description String
  unit_price  Decimal  @db.Decimal(10, 2)
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  deliveredAt DateTime @map("delivered_at") @db.Timestamptz
  note        String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
  @@schema("public")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  amount         Decimal           @db.Decimal(10, 2)
  method         TransactionMethod
  madeAt         DateTime          @map("madeAt") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("transaction")
  @@schema("public")
}

enum OrderStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  PREPARING @map("preparing")
  READY     @map("ready")
  DELIVERED @map("delivered")
  CANCELLED @map("cancelled")

  @@map("order_status")
  @@schema("public")
}

enum TransactionMethod {
  PIX         @map("pix")
  CASH        @map("cash")
  CREDIT_CARD @map("credit_card")
  DEBIT_CARD  @map("debit_card")
  TRANSFER    @map("transfer")

  @@map("transaction_method")
  @@schema("public")
}
